[gd_resource type="Resource" script_class="QuestData" load_steps=5 format=3]

[ext_resource type="Script" path="res://Game/Quest/QuestData.gd" id="1_quest"]
[ext_resource type="Script" path="res://Game/Quest/QuestObjectiveData.gd" id="2_objective"]
[ext_resource type="Script" path="res://Game/Quest/QuestRewardData.gd" id="3_reward"]
[ext_resource type="Texture2D" path="res://icon.svg" id="4_icon"]

[sub_resource type="Resource" id="QuestObjectiveData_done"]
script = ExtResource("2_objective")
objective_id = &"deliver_supplies"
description = "Deliver the emergency supplies to the lookout."
event_key = &"deliver_supplies"
target_display_name = "Lookout"
auto_complete_on_match = true

[sub_resource type="Resource" id="QuestRewardData_gold"]
script = ExtResource("3_reward")
label = "Field Stipend"
amount = 230
icon = ExtResource("4_icon")

[resource]
script = ExtResource("1_quest")
quest_id = &"finished_delivery"
title = "Finished Delivery"
subtitle = "North Gate"
summary = "The supply drop already reached the lookout. This quest exists to preview completed styling in the journal."
category = &"legend"
sort_order = 2
objectives = Array[Resource]([SubResource("QuestObjectiveData_done")])
rewards = Array[Resource]([SubResource("QuestRewardData_gold")])
starts_active = false
starts_completed = true
